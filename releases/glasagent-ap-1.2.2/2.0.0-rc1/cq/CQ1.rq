# CQ1 - Which simulation processes - and of which simulation family (atomistic,
#        thermochemical, data-driven) - can determine a given glass property
#        (density, glass transition temperature, viscosity, elastic moduli)?
#
# PATH:   simulation run --rdf:type--> family subclass (subclass closure);
#         run --obo:OBI_0000299 (has specified output)--> simulated property datum;
#         datum --obo:IAO_0000136 (is about)--> property INSTANCE;
#         property --rdf:type--> property class (class lifted only via typing).
# EXPECTED RESULT COLUMNS:
#         ?familyClass   - go:GO_0000301 (atomistic glass simulation),
#                          go:GO_0000303 (thermochemical glass simulation) or
#                          go:GO_0000305 (data-driven glass property prediction)
#         ?simClass      - the asserted process class of the run
#         ?propertyClass - the property class the datum is about
# EXPECTED ROW COUNT on the 2.0.0-rc1 package: 3 - (GO_0000301, GO_0000302, PMD_0000597),
#         (GO_0000301, GO_0000302, GO_0000046) and (GO_0000305, GO_0000305, PMD_0000597).
# GRAPH ASSUMPTION: answers are computed on the ASSERTED graph only - rdfs:subClassOf*
#         traverses asserted subclass axioms; no OWL reasoning (including
#         owl:equivalentClass-based classification) is required or claimed. A reasoner
#         may widen the answer set; the expected count below refers to the asserted union.
# LIMITS: viscosity (go:GO_0000046) resolves through the additive baseline repair
#         contained in go_v2_candidate.ttl. Elastic modulus uses the baseline class
#         co:PMD_0000618. Class IRIs occur only in rdf:type / rdfs:subClassOf* / VALUES
#         positions, never as object-property targets.
# VALIDATION: executed for the presentation-stage 2.0.0-rc1 package against the asserted
#         union of go_v2_candidate.ttl and the synthetic abox_meltquench_example.ttl
#         (Apache Jena arq and RDFLib, identical results).
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX co:   <https://w3id.org/pmd/co/>
PREFIX go:   <https://w3id.org/pmd/glass-ontology/>

SELECT DISTINCT ?familyClass ?simClass ?propertyClass
WHERE {
  # the three Tier-1 family classes (PLAN §7.1; terms_simulation.csv)
  VALUES ?familyClass { go:GO_0000301 go:GO_0000303 go:GO_0000305 }

  # Tier-1 property targets; viscosity via the approved D-039 repair (activated by D-041)
  VALUES ?propertyClass { co:PMD_0000597 go:GO_0000016 co:PMD_0000618 go:GO_0000046 }

  ?run      rdf:type ?simClass .
  ?simClass rdfs:subClassOf* ?familyClass .

  ?run      obo:OBI_0000299 ?simDatum .                     # has specified output
  ?simDatum rdf:type/rdfs:subClassOf* go:GO_0000318 .       # simulated property datum
  ?simDatum obo:IAO_0000136 ?property .                     # is about (an instance)
  ?property rdf:type/rdfs:subClassOf* ?propertyClass .
}
ORDER BY ?familyClass ?simClass ?propertyClass
