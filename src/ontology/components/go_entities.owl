            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">ion diffusion</rdfs:label>
        <skos:comment>SciGlass 7.0@en</skos:comment>
        <skos:definition xml:lang="en">Diffusion of ions inside the glass or into the glass bulk from the surface.@en</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/glass-ontology/GO_0000080 -->

    <owl:Class rdf:about="https://w3id.org/pmd/glass-ontology/GO_0000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">standard issuing process</rdfs:label>
        <skos:definition xml:lang="en">A planned process that has the objective to develop, review, approve, and publish a standard through the procedures of a recognized standards body and consensus-based standardization workflow.@en</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/glass-ontology/GO_0000081 -->

    <owl:Class rdf:about="https://w3id.org/pmd/glass-ontology/GO_0000081">
