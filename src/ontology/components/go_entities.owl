            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">standard issuer role</rdfs:label>
        <skos:definition xml:lang="en">A role that inheres in an organization by virtue of its recognized responsibility to develop, approve, or publish standards.@en</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/glass-ontology/GO_0000079 -->

    <owl:Class rdf:about="https://w3id.org/pmd/glass-ontology/GO_0000079">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020194"/>
